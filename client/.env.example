# LAMBO Client Environment Configuration

# Backend API Base URL
VITE_API_URL=http://localhost:5000/api

# VAPID Public Key for Web Push Notifications
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# Optional: Map API Key (Leave blank to use free OpenStreetMap tiles with no watermark or limits)
# If you have a CARTO Basemaps API key, add it here:
VITE_CARTO_API_KEY=
# Or custom tile URL template:
VITE_MAP_TILE_URL=
